{"name": "talos_principle_reawakened", "game": "The Talos Principle Reawakened", "version": "1.4.0", "hidden": false, "groups": [{"name": "Game Options", "options": [{"name": "progression_balancing", "display_name": "Progression Balancing", "description": "A system that can move progression earlier, to try and prevent the player from getting stuck and bored early.\n\nA lower setting means more getting stuck. A higher setting means less getting stuck.", "randomizable": true, "visibility": 15, "type": "NamedRange", "default": 50, "min": 0, "max": 99, "presets": {"disabled": 0, "normal": 50, "extreme": 99}}, {"name": "accessibility", "display_name": "Accessibility", "description": "Set rules for reachability of your items/locations.\n\n**Full:** ensure everything can be reached and acquired.\n\n**Minimal:** ensure what is needed to reach your goal can be acquired.", "randomizable": true, "visibility": 15, "type": "Choice", "default": 0, "choices": [{"name": "full", "display_name": "Full", "value": 0}, {"name": "minimal", "display_name": "Minimal", "value": 2}]}, {"name": "starting_tetromino_count", "display_name": "Starting Tetromino Count", "description": "Number of random tetrominoes to start with.\nThis can help prevent softlocks and make the early game more forgiving.", "randomizable": true, "visibility": 15, "type": "Choice", "default": 0, "choices": [{"name": "0", "display_name": "0", "value": 0}, {"name": "3", "display_name": "3", "value": 3}, {"name": "5", "display_name": "5", "value": 5}, {"name": "10", "display_name": "10", "value": 10}]}, {"name": "reusable_tetrominoes", "display_name": "Reusable Tetrominoes", "description": "When enabled, tetrominoes are returned to the player after being placed in\na gate, tool panel, or tower door, making each piece reusable.\n\nThis dramatically reduces the number of tetrominoes required to reach climb\nthe tower (from 90 down to ~37).", "randomizable": true, "visibility": 15, "type": "Toggle", "default": false}, {"name": "randomise_purple_sigils", "display_name": "Randomise Purple Sigils", "description": "When enabled, the 24 Purple Sigils hidden throughout the worlds are randomised", "randomizable": true, "visibility": 15, "type": "Toggle", "default": false}, {"name": "randomise_stars", "display_name": "Randomise Stars", "description": "When enabled, the 30 Stars hidden throughout the worlds are randomised.", "randomizable": true, "visibility": 15, "type": "Toggle", "default": false}, {"name": "randomise_bonus_puzzles", "display_name": "Randomise Bonus Puzzles", "description": "When enabled, the 9 Bonus White tetrominoes are randomised.\n\nIf stars are also randomised, logic will require all 30 stars to be collected before \nthe bonus puzzles can be completed due to the potential of unlocking them in any order,\nunless an order is specified in bonus_level_order below.", "randomizable": true, "visibility": 15, "type": "Toggle", "default": false}, {"name": "shuffle_mechanics", "display_name": "Shuffle Mechanics", "description": "When enabled, Golden tetrominoes are removed from the item pool and the\nfive mechanic tools (Connector, Hexahedron, Fans, Playback, Platform)\nare shuffled into the item pool.\n\nThis option is still in development and is not fully functional. \nIt is recommended to leave this option disabled for now.", "randomizable": true, "visibility": 15, "type": "Toggle", "default": false}, {"name": "shuffle_world_gates", "display_name": "Shuffle Messenger Gates", "description": "When enabled, Green tetrominoes are removed from the item pool and the\nfour world gates (World A1 Gate, World A Gate, World B Gate, World C\nGate) are shuffled into the item pool.\n\nWhen received, the tetrominoes required to open the gate will be granted to the player", "randomizable": true, "visibility": 15, "type": "Toggle", "default": false}, {"name": "bonus_level_order", "display_name": "Bonus Level Order", "description": "Logic normally requires all 30 stars to access the 3 bonus levels, to avoid potential softlocks.\nThis option allows for specifying the access order for the 3 bonus levels. If an order is specified,\nyou will still need the appropriate world access and puzzle mechanics unlocked to complete them.\n\nFor example, selecting \"BAC\" would put world B's bonus level into logic at 10 stars, A's at 20, and C's at 30.\n\"unchanged\" keeps the above behavior, requiring all 30 stars for bonus level access.", "randomizable": true, "visibility": 15, "type": "Choice", "default": 0, "choices": [{"name": "unchanged", "display_name": "Unchanged", "value": 0}, {"name": "abc", "display_name": "Abc", "value": 1}, {"name": "acb", "display_name": "Acb", "value": 2}, {"name": "bac", "display_name": "Bac", "value": 3}, {"name": "bca", "display_name": "Bca", "value": 4}, {"name": "cab", "display_name": "Cab", "value": 5}, {"name": "cba", "display_name": "Cba", "value": 6}]}, {"name": "messenger_island_order", "display_name": "Messenger Island Order", "description": "Logic normally requires all 24 purple sigils to access the 3 messenger islands, to avoid potential softlocks.\nThis option allows for specifying the access order for the 3 messenger islands. If an order is specified,\nyou will still need the appropriate world access to access them.\n\nNote this option currently has minimal value, because the only messenger island check currently is the star in\nmessenger island A. Thus, setting an order only affects how late into the seed that star may enter logic.\nThis option will gain value if messenger items are added as Archipelago items in the future.\n\nFor example, selecting \"CAB\" would put messenger island A's star into logic at 16 purple sigils.\n\"unchanged\" keeps the above behavior, requiring all 24 purple sigils for messenger island access.", "randomizable": true, "visibility": 15, "type": "Choice", "default": 0, "choices": [{"name": "unchanged", "display_name": "Unchanged", "value": 0}, {"name": "abc", "display_name": "Abc", "value": 1}, {"n