{"name": "splasher", "game": "Splasher", "version": "0.0.6", "hidden": false, "groups": [{"name": "Game Options", "options": [{"name": "progression_balancing", "display_name": "Progression Balancing", "description": "A system that can move progression earlier, to try and prevent the player from getting stuck and bored early.\n\nA lower setting means more getting stuck. A higher setting means less getting stuck.", "randomizable": true, "visibility": 15, "type": "NamedRange", "default": 50, "min": 0, "max": 99, "presets": {"disabled": 0, "normal": 50, "extreme": 99}}, {"name": "accessibility", "display_name": "Accessibility", "description": "Set rules for reachability of your items/locations.\n\n**Full:** ensure everything can be reached and acquired.\n\n**Minimal:** ensure what is needed to reach your goal can be acquired.", "randomizable": true, "visibility": 15, "type": "Choice", "default": 0, "choices": [{"name": "full", "display_name": "Full", "value": 0}, {"name": "minimal", "display_name": "Minimal", "value": 2}]}, {"name": "include_medals", "display_name": "Include Speedrun Medals", "description": "Determine if speedrun medals should reward a check. If enabled, each tier rewards a check.\n\nOff - Not included \nBronze - Reward up to bronze medals\nSilver - Reward up to silver medals\nGold - Reward up to gold medals\nPlatinum - Reward up to platinum medals", "randomizable": true, "visibility": 15, "type": "Choice", "default": 0, "choices": [{"name": "off", "display_name": "Off", "value": 0}, {"name": "bronze", "display_name": "Bronze", "value": 1}, {"name": "silver", "display_name": "Silver", "value": 2}, {"name": "gold", "display_name": "Gold", "value": 3}, {"name": "platinum", "display_name": "Platinum", "value": 4}]}, {"name": "include_speedrun_keys", "display_name": "Include Speedrun Keys", "description": "Determine if time attack should have its own keys. This is only relevant if `Include Keys` is enabled.\n\nOff - A key unlocks a level in both modes\nOn - Include keys specific to Time Attack. Key pattern will match the one of `Include Keys` (Off, Zone or Level)", "randomizable": true, "visibility": 15, "type": "Toggle", "default": false}], "collapsed": false}, {"name": "Randomizer options", "options": [{"name": "randomize_powers", "display_name": "Randomize Powers", "description": "Determine how to unlock powers (water and paint) in the game\n\nOff - Powers aren't randomized : you need to reach the power unlock in the intended level\nOn - Power unlocks are randomized into the pool\nOn Except Water - Randomize Stickink and Bouncink, but unlock Water as normal. This prevents the early game to be too restrictive.\nProgressive - Powers are randomized as progressive items : water, then stickink, then bouncink", "randomizable": true, "visibility": 15, "type": "Choice", "default": 1, "choices": [{"name": "off", "display_name": "Off", "value": 0}, {"name": "on", "display_name": "On", "value": 1}, {"name": "on_except_water", "display_name": "On Except Water", "value": 2}, {"name": "progressive", "display_name": "Progressive", "value": 3}]}, {"name": "randomize_golden_splashers", "display_name": "Randomize Golden Splashers", "description": "Determine if golden splashers are added in the item pool", "randomizable": true, "visibility": 15, "type": "Toggle", "default": true}, {"name": "include_keys", "display_name": "Include Keys", "description": "Determine if levels should be locked behind keys\nIf enabled, the first level will still be unlocked\n\nOff - Do not include keys : every level is unlocked from start\nZone - Include thematic keys : each key unlocks from 3 to 5 levels\nLevel - Include a key for each level : each key unlocks one level", "randomizable": true, "visibility": 15, "type": "Choice", "default": 0, "choices": [{"name": "off", "display_name": "Off", "value": 0}, {"name": "zone", "display_name": "Zone", "value": 1}, {"name": "level", "display_name": "Level", "value": 2}]}], "collapsed": false}, {"name": "Goal", "options": [{"name": "splashers_goal", "display_name": "Splashers Goal", "description": "Determine how many splashers are needed to unlock the final level", "randomizable": true, "visibility": 15, "type": "Range", "default": 80, "min": 0, "max": 154}], "collapsed": false}, {"name": "Optional items", "options": [{"name": "include_essence_items", "display_name": "Include essence items", "description": "Determine if the pool includes essence items in the junk pool. \nThese are stored until a manual release inside a level, upon which these are added to the current counter.", "randomizable": true, "visibility": 15, "type": "Toggle", "default": true}], "collapsed": false}, {"name": "Making your life miserable", "options": [{"name": "trap_chance", "display_name": "Trap Chance", "description": "Average amount of traps in the filler pool", "randomizable": true, "visibility": 15, "type": "Range", "default": 0, "min": 0, "max": 100}, {"name": "death_link", "display_name": "DeathLink", "description": "Determine which death link level to apply\n\nOff - Don't enable death link\nOn - Enable death link, which is triggered on your side every 5 deaths\nBrave - Trigger on 3 deaths\nInsane - Trigger on every death\nLegend - Also trigger the death link when you accidentally kill a splasher", "randomizable": true, "visibility": 15, "type": "Choice", "default": 0, "choices": [{"name": "off", "display_name": "Off", "value": 0}, {"name": "on", "display_name": "On", "value": 1}, {"name": "insane", "display_name": "Insane", "value": 2}, {"name": "legend", "display_name": "Legend", "value": 3}]}, {"name": "hero_mode", "display_name": "Hero Mode", "description": "Enable Hero Mode, in which killing a Splasher triggers a death for the player as well.\nNotice this counts towards Death Link if enabled", "randomizable": true, "visibility": 15, "type": "Toggle", "default": false}], "collapsed": false}, {"name": "Item & Location Options", "options": [{"name": "local_items", "display_name": "Local Items