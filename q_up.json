{"name": "q_up", "game": "Q-UP", "version": "0.0.0", "hidden": false, "groups": [{"name": "Game Options", "options": [{"name": "progression_balancing", "display_name": "Progression Balancing", "description": "A system that can move progression earlier, to try and prevent the player from getting stuck and bored early.\n\nA lower setting means more getting stuck. A higher setting means less getting stuck.", "randomizable": true, "visibility": 15, "type": "NamedRange", "default": 50, "min": 0, "max": 99, "presets": {"disabled": 0, "normal": 50, "extreme": 99}}, {"name": "accessibility", "display_name": "Accessibility", "description": "Set rules for reachability of your items/locations.\n\n**Full:** ensure everything can be reached and acquired.\n\n**Minimal:** ensure what is needed to reach your goal can be acquired.", "randomizable": true, "visibility": 15, "type": "Choice", "default": 0, "choices": [{"name": "full", "display_name": "Full", "value": 0}, {"name": "minimal", "display_name": "Minimal", "value": 2}]}, {"name": "champ", "display_name": "Champ", "description": "Choose the champion you want to play as, or randomize this option.", "randomizable": true, "visibility": 15, "type": "Choice", "default": "random", "choices": [{"name": "gambler", "display_name": "Gambler", "value": 0}, {"name": "medic", "display_name": "Medic", "value": 1}, {"name": "pro", "display_name": "Pro", "value": 2}, {"name": "troll", "display_name": "Troll", "value": 3}, {"name": "streamer", "display_name": "Streamer", "value": 4}, {"name": "whale", "display_name": "Whale", "value": 5}, {"name": "robot", "display_name": "Robot", "value": 6}, {"name": "wizard", "display_name": "Wizard", "value": 7}]}], "collapsed": false}, {"name": "Item Pool", "options": [{"name": "itemPoolTotalSkillNum", "display_name": "Total Number of Skills", "description": "Set the maximum amount of skills you want to find in total.\nThis amount includes the amount of signature and upgradable skills.\nDefaults to 35, which is close to the vanilla amount.\n\nTo avoid fill errors, the generator may decide to lower this number automatically.", "randomizable": true, "visibility": 15, "type": "Range", "default": 35, "min": 20, "max": 50}, {"name": "itemPoolFixedSkillNum", "display_name": "Maximum Number of Fixed Skills", "description": "Set the number of fixed, upgradable skills.\nDefaults to 12, which is the vanilla amount.", "randomizable": true, "visibility": 15, "type": "Range", "default": 12, "min": 0, "max": 18}, {"name": "itemPoolSkillUpgradeNum", "display_name": "Maximum Number of Skill Upgrades", "description": "Set the number of skill upgrades in the item pool.\nThese are used to upgrade fixed skills.\nDefaults to 35, which is the vanilla amount.\n\nYou can calculate the recommended amount like this:\n3 * (number of fixed skills)\n\nTo avoid fill errors, the generator may decide to lower this number automatically.\n\nThe generator will cap this number at 6 * (number of fixed skills).", "randomizable": true, "visibility": 15, "type": "Range", "default": 35, "min": 0, "max": 50}, {"name": "itemPoolProgressiveCrystalsNum", "display_name": "Minimum amount of Crystals to include", "description": "Crystals are usually a major part of the game's progression,\nbut they also take up a high number of possible locations.\n\nHere you can set a minimum amount of Crystals to be included\nin the item pool. Crystals can still appear as filler item,\nregardless of this setting.", "randomizable": true, "visibility": 15, "type": "Range", "default": 35, "min": 20, "max": 50}, {"name": "itemPoolEfficiencyCrystals", "display_name": "Crystal Item Efficiency", "description": "This setting increases the amount of crystals you receive at once.\nIn turn, it reduces the amount of crystals drops in the item pool.\nFor example, when set to 2, it will give twice as many crystals at\nonce and reduce the number of crystals in the item pool by half (1/2).\n\nTo avoid fill errors, it is recommended to set this to at least 2.", "randomizable": true, "visibility": 15, "type": "Range", "default": 2, "min": 1, "max": 4}, {"name": "itemPoolEfficiencyUpgradePoints", "display_name": "Upgrade Point Efficiency", "description": "This setting increases the amount of upgrade points you receive at once.\nIn turn, it reduces the amount of upgrade points drops in the item pool.\nFor example, when set to 2, it will give twice as many upgrade points at\nonce and reduce the number of upgrade points in the item pool by half (1/2).\n\nTo avoid fill errors, it is recommended to set this to at least 2.", "randomizable": true, "visibility": 15, "type": "Range", "default": 2, "min": 1, "max": 4}], "collapsed": false}, {"name": "Sanity", "options": [{"name": "sanityNumChallenges", "display_name": "Amount of Challenge Locations", "description": "This setting adds special challenges that reward location checks.\nBy default, this will add 4x tier 1 challenges, 3x tier 2 challenges,\n2x tier 3 challenges and 1x tier 4 challenge.", "randomizable": true, "visibility": 15, "type": "Range", "default": 10, "min": 0, "max": 30}, {"name": "sanityNumChallengesTier4", "display_name": "Maximum amount of Tier 4 Challenges", "description": "Here you can choose the maximum amount of tier 4 challenges to add.\nTier 4 challenges only appear if amount of challenge locations is set\nto at least 10.", "randomizable": true, "visibility": 15, "type": "Range", "default": 1, "min": 0, "max": 6}], "collapsed": false}, {"name": "Item & Location Options", "options": [{"name": "local_items", "display_name": "Local Items", "description": "Forces these items to be in their native world.", "randomizable": false, "visibility": 15, "type": "OptionSet", "default": [], "options": ["Action Junky", "Raise the Stakes", "Multi-Table", "Long Odds", "Game Theory", "Coinflip", "Expected Value", "Crapshoot", "Downswing", "Monster", "Little Brother", "Never Tell Me the Odds", "Three of a Kind", "Make It Rain", "Upswing", "Ship It", "Mixed 