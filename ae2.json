{"name": "ae2", "game": "Ape Escape 2", "version": "1.0.1", "hidden": false, "groups": [{"name": "Game Options", "options": [{"name": "progression_balancing", "display_name": "Progression Balancing", "description": "A system that can move progression earlier, to try and prevent the player from getting stuck and bored early.\n\nA lower setting means more getting stuck. A higher setting means less getting stuck.", "randomizable": true, "visibility": 15, "type": "NamedRange", "default": 50, "min": 0, "max": 99, "presets": {"disabled": 0, "normal": 50, "extreme": 99}}, {"name": "accessibility", "display_name": "Accessibility", "description": "Set rules for reachability of your items/locations.\n\n**Full:** ensure everything can be reached and acquired.\n\n**Minimal:** ensure what is needed to reach your goal can be acquired.", "randomizable": true, "visibility": 15, "type": "Choice", "default": 0, "choices": [{"name": "full", "display_name": "Full", "value": 0}, {"name": "minimal", "display_name": "Minimal", "value": 2}]}], "collapsed": false}, {"name": "AP Settings", "options": [{"name": "death_link", "display_name": "Death Link", "description": "When you die, everyone who enabled death link dies. Of course, the reverse is true too.", "randomizable": true, "visibility": 15, "type": "Toggle", "default": false}], "collapsed": false}, {"name": "Playthrough", "options": [{"name": "goal", "display_name": "Goal", "description": "Determines your victory condition.\n\n- specter: Find your World Keys and complete the \"Showdown with Specter!\" boss fight.\n- final_specter: Find your World Keys, catch every monkey in the game and complete the \"Final Showdown with Specter!\" boss fight.", "randomizable": true, "visibility": 15, "type": "Choice", "default": 0, "choices": [{"name": "specter", "display_name": "Specter", "value": 0}, {"name": "final_specter", "display_name": "Final Specter", "value": 1}]}, {"name": "level_shuffle", "display_name": "Level Shuffle", "description": "Randomises the order of level unlocks.\nYour final battle with Specter will always be placed at the end of the game.\n\n- off: Levels will appear in their default order.\n- separate: Levels and bosses will be shuffled separately.\n- mixed: Levels and bosses will be shuffled together.", "randomizable": true, "visibility": 15, "type": "Choice", "default": 0, "choices": [{"name": "off", "display_name": "Off", "value": 0}, {"name": "separate", "display_name": "Separate", "value": 1}, {"name": "mixed", "display_name": "Mixed", "value": 2}]}, {"name": "world_key_behaviour", "display_name": "World Key Behaviour", "description": "Determines the behaviour of \"World Key\" items.\n\n- level: Each \"World Key\" item will unlock one additional level.\n- world: Each \"World Key\" item will unlock all levels up to (and including) the next boss fight.\n- alternating: \"World Key\" items will alternate between unlocking all levels leading up to the next boss fight, and unlocking the boss fight itself.", "randomizable": true, "visibility": 15, "type": "Choice", "default": 2, "choices": [{"name": "level", "display_name": "Level", "value": 0}, {"name": "world", "display_name": "World", "value": 1}, {"name": "alternating", "display_name": "Alternating", "value": 2}]}, {"name": "playable_character", "display_name": "Playable Character", "description": "Determines which character you will play as.\n\n- hikaru: Play as Hikaru (Jimmy). Pipotchi will tag along to help you out.\n- kakeru: Play as Kakeru (Spike). You won't have Pipotchi's help.", "randomizable": true, "visibility": 15, "type": "Choice", "default": 0, "choices": [{"name": "hikaru", "display_name": "Hikaru", "value": 0}, {"name": "kakeru", "display_name": "Kakeru", "value": 1}]}, {"name": "starting_gadgets", "display_name": "Starting Gadgets", "description": "Determines which gadgets you will begin the game with, in addition to the Monkey Net.\nYou may enter \"Random\" multiple times to receive multiple random gadgets.\n\nValid names are: \"Random\", \"Stun Club\", \"Monkey Radar\", \"Dash Hoop\", \"Catapult\", \"Sky Flyer\", \"R.C. Car\", \"Bananarang\", \"Water Cannon\", \"Electro Magnet\", \"Power Punch\"", "randomizable": false, "visibility": 15, "type": "OptionList", "default": ["Stun Club"], "options": ["Bananarang", "Catapult", "Dash Hoop", "Electro Magnet", "Monkey Radar", "Power Punch", "R.C. Car", "Random", "Sky Flyer", "Stun Club", "Water Cannon"]}, {"name": "shuffle_water_net", "display_name": "Shuffle Water Net", "description": "Determines whether to lock the Water Net behind receiving an item.\nIf this is enabled and you haven't received the Water Net, then touching water will instantly cause you to respawn.", "randomizable": true, "visibility": 15, "type": "Toggle", "default": true}, {"name": "shuffle_air_crawl", "display_name": "Shuffle Air Crawl", "description": "Determines whether to lock the Air Crawl glitch behind receiving an item.\nIf this is enabled and you haven't received the Air Crawl item, then you will be unable to perform the glitch.", "randomizable": true, "visibility": 15, "type": "Toggle", "default": false}], "collapsed": false}, {"name": "Logic & Tricks", "options": [{"name": "logic_difficulty", "display_name": "Logic Difficulty", "description": "Determines the overall difficulty of logic.\nCertain tricks or glitches can be enabled separately.\n\n- normal: You will be logically expected to have a majority of gadgets at your disposal.\n- hard: You will be logically expected to use gadgets in novel ways.\n- expert: You will be logically expected to make difficult jumps and use gadgets in unexpected ways. Hip drop attacks and rocket dives may be essential.", "randomizable": true, "visibility": 15, "type": "Choice", "default": 0, "choices": [{"name": "normal", "display_name": "Normal", "value": 0}, {"name": "hard", "display_name": "Hard", "value": 1}, {"name": "expert", "display_name": "Expert", "value": 2}]}, {"name": "hidden_monkey_logic", "display_name": "Hidden Monkey Logic", "description": "If this option is enabled, certain well-hidden monkeys will logically expect the Monkey Radar or See-All Scope.\nThis option is recommended for inexperienced players who do not already know where each monkey is located.", "randomizable": true, "visibility": 15, "type": "Toggle", "default": false}, {"name": "damage_boost_logic", "display_name": "Damage Boost Logic", "description": "If this option is enabled, intentionally taking damage to pass through fire and other hazards will be logically expected.", "randomizable": true, "visibility": 15, "type": "Toggle", "default": true}, {"name": "air_crawl_logic", "display_name": "Air Crawl Logic", "description": "If this option is enabled, using the Air Crawl glitch will be logically expected.", "randomizable": true, "visibility": 15, "type": "Toggle", "default": false}, {"name": "boost_jump_logic", "display_name": "Boost Jumping Logic", "description": "If this option is enabled, swinging the net as you double jump before swapping to another gadget for increased height will be logically expected.", "randomizable": true, "visibility": 15, "type": "Toggle", "default": false}, {"name": "boost_fly_logic", "display_name": "Boost Flying Logic", "description": "If this option is enabled, performing a boost jump into the Sky Flyer will be logically expected.", "randomizable": true, "visibility": 15, "type": "Toggle", "default": false}, {"name": "long_jump_logic", "display_name": "Long Jumping Logic", "description": "If this option is enabled, performing a neutral jump with the Dash Hoop will be logically expected.", "randomizable": true, "visibility": 15, "type": "Toggle", "default": false}], "collapsed": false}, {"name": "Item & Location Options", "options": [{"name": "local_items", "display_name": "Local Items", "description": "Forces these items to be in their native world.", "randomizable": false, "visibility": 15, "type": "OptionSet", "default": [], "options": ["Monkey Net", "Stun Club", "Monk