{"name": "untitled_goose_game", "game": "Untitled Goose Game", "version": "0.0.0", "hidden": false, "groups": [{"name": "Game Options", "options": [{"name": "progression_balancing", "display_name": "Progression Balancing", "description": "A system that can move progression earlier, to try and prevent the player from getting stuck and bored early.\n\nA lower setting means more getting stuck. A higher setting means less getting stuck.", "randomizable": true, "visibility": 15, "type": "NamedRange", "default": 50, "min": 0, "max": 99, "presets": {"disabled": 0, "normal": 50, "extreme": 99}}, {"name": "accessibility", "display_name": "Accessibility", "description": "Set rules for reachability of your items/locations.\n\n**Full:** ensure everything can be reached and acquired.\n\n**Minimal:** ensure what is needed to reach your goal can be acquired.", "randomizable": true, "visibility": 15, "type": "Choice", "default": 0, "choices": [{"name": "full", "display_name": "Full", "value": 0}, {"name": "minimal", "display_name": "Minimal", "value": 2}]}, {"name": "starting_area", "display_name": "Starting Area", "description": "Which area the player starts with access to. \nWithout this, you'd be stuck at the hub with nothing to do!\nModel Village is not an option since it's the finale area.", "randomizable": true, "visibility": 15, "type": "Choice", "default": "random", "choices": [{"name": "garden", "display_name": "Garden", "value": 0}, {"name": "high_street", "display_name": "High Street", "value": 1}, {"name": "back_gardens", "display_name": "Back Gardens", "value": 2}, {"name": "pub", "display_name": "Pub", "value": 3}]}, {"name": "goal", "display_name": "Goal", "description": "Victory is always when you steal the Golden Bell and bring it home. Goal settings change how it spawns:\nonly_steal = Simply reach the bell and steal it!\nfind_bell = The Golden Bell is lost somewhere in the multiworld! Find it before you can steal it.\nall_main_tasks = Complete all four area task lists to spawn the Golden Bell.\nonly_speedrun_tasks = Complete all 'To Do (Quickly!!)' tasks to spawn the Golden Bell.\nall_tasks_no_speedrun = Complete all four area task lists as well as the 'To Do (As Well)' task lists to spawn the Golden Bell.\nall_tasks = Complete all task lists to spawn the Golden Bell.\nfour_final_tasks = Complete the final task of each of the four area task lists to spawn the Golden Bell.", "randomizable": true, "visibility": 15, "type": "Choice", "default": 0, "choices": [{"name": "only_steal", "display_name": "Only Steal", "value": 0}, {"name": "find_bell", "display_name": "Find Bell", "value": 1}, {"name": "all_main_tasks", "display_name": "All Main Tasks", "value": 2}, {"name": "only_speedrun_tasks", "display_name": "Only Speedrun Tasks", "value": 3}, {"name": "all_tasks_no_speedrun", "display_name": "All Tasks No Speedrun", "value": 4}, {"name": "all_tasks", "display_name": "All Tasks", "value": 5}, {"name": "four_final_tasks", "display_name": "Four Final Tasks", "value": 6}]}, {"name": "include_npc_souls", "display_name": "Include NPC Souls", "description": "When enabled, NPCs won't appear until you receive their soul item.\nThis adds NPC souls to the item pool and gates NPC-related goals behind them.", "randomizable": true, "visibility": 15, "type": "Toggle", "default": true}, {"name": "logically_require_npc_souls", "display_name": "Logically Require NPC Souls", "description": "This option is only for when NPC Souls are included in the pool. When enabled, generation will think that all NPCs are required in order to complete the goal.\nYou may be more likely to find them in your seed, which may make the experience more satisfying. NPCs make the final sequence of stealing the bell more difficult and interesting.\nWARNING: Only enable this option if you know what you are doing. Many NPCs may not be required in order to complete the goal, and doing so without them will be going out of logic!", "randomizable": true, "visibility": 15, "type": "Toggle", "default": false}, {"name": "include_prop_souls", "display_name": "Include Props", "description": "When enabled, items can't be picked up or dragged until you receive them.\nThis adds props to the item pool and gates item interactions behind them.\nIf the find_bell goal is chosen and this option is disabled, the Golden Bell will be the only one added to the pool.", "randomizable": true, "visibility": 15, "type": "Toggle", "default": true}, {"name": "include_extra_tasks", "display_name": "Include Extra Tasks", "description": "Include post-game extra challenge tasks as locations.\nMust be enabled when choosing either the all_tasks_no_speedrun or all_tasks goal.", "randomizable": true, "visibility": 15, "type": "Toggle", "default": false}, {"name": "include_speedrun_tasks", "display_name": "Include Speedrun Tasks", "description": "Include speedrun challenge tasks (complete areas before noon).\nMust be enabled when choosing either the only_speedrun_tasks or all_tasks goal.", "randomizable": true, "visibility": 15, "type": "Toggle", "default": false}, {"name": "include_item_pickups", "display_name": "Include Item Pickups", "description": "Include first-time item pickups as locations (100+ additional checks).\nMust be enabled when including prop souls in the pool.", "randomizable": true, "visibility": 15, "type": "Toggle", "default": true}, {"name": "include_drag_items", "display_name": "Include Drag Items", "description": "Include first-time drag item locations (50+ additional checks for heavy/draggable items).", "randomizable": true, "visibility": 15, "type": "Toggle", "default": true}, {"name": "include_interactions", "display_name": "Include Interactions", "description": "Include interaction locations (ringing bells, spinning windmills, breaking boards, etc.).", "randomizable": true, "visibility": 15, "type": "Toggle", "default": true}, {"name": "include_model_church_pecks", "display_name": "Include Model Church Pecks", "description": "Include locations for pecking the model church apart\nfirst_pecks_only - includes two locations; \nall_pecks - includes all 35 pecks each as their own location", "randomizable": true, "visibility": 15, "type": "Choice", "default": 1, "choices": [{"name": "none", "display_name": "None", "value": 0}, {"name": "first_pecks_only", "display_name": "First Pecks Only", "value": 1}, {"name": "all_pecks", "display_name": "All Pecks", "value": 2}]}, {"name": "include_milestone_locations", "display_name": "Include Milestone Locations", "description": "Include extra locations for completing all garden tasks, all high street tasks, etc.\n- Including extra tasks adds a milestone for completing all To Do (As Well) tasks\n- Including speedrun tasks adds a milestone for completing all speedrun tasks", "randomizable": true, "visibility": 15, "type": "Toggle", "default": true}, {"name": "include_new_tasks", "display_name": "Include New Tasks", "description": "Include locations for new tasks created for this archipelago!\nSome of these happen naturally throughout gameplay, and some are more involved.\nYou can view these tasks at any time in-game by pressing F4. New tasks include:\n- Break the intro gate\n- Drop some mail in the well\n- Short out the garden radio\n- Lock the groundskeeper IN the garden\n- Trap the TV shop owner in the garage\n- Break through the boards to the back gardens\n- Make the woman fix the topiary\n- Pose as a duck statue\n- Dress up the bush with both ribbons\n- Do some interior redecorating\n- Trip the burly man\n- Break a pint glass\n- Perform at the pub with a harmonica", "randomizable": true, "visibility": 15, "type": "Toggle", "default": false}, {"name": "filler_amount_mega_honk", "display_name": "Filler Amount: Mega Honk", "description": "Amount of Mega Honk in the filler pool.\nMega Honk effects - upgraded honking abilities\nLevel 1: All NPCs react to honk (draws attention) - default behavior enhanced\nLevel 2: Increased honk detection distance - always heard regardless of distance\nLevel 3: Scary honk - NPCs drop held items", "randomizable": true, "visibility": 15, "type": "Range", "default": 3, "min": 0, "max": 3}, {"name": "filler_amount_speedy_feet", "display_name": "Filler Amount: Speedy Feet", "description": "Amount of Speedy Feet in filler pool. Speedy Feet increases your run speed.", "randomizable": true, "visibility": 15, "type": "Range", "default": 10, "min": 0, "max": 10}, {"name": "filler_active_silent_steps", "display_name": "Filler Active: Silent Steps", "description": "Whether or not Silent Steps is in the filler pool. Silent Steps prevents NPCs from hearing your footsteps.", "randomizable": true, "visibility": 15, "type": "Toggle", "default": true}, {"name": "filler_amount_goose_day", "display_name": "Filler Amount: A Goose Day", "description": "Amount of A Goose Day in filler pool. A Goose Day causes NPCs to ignore you for 15 seconds.", "randomizable": true, "visibility": 15, "type": "Range", "default": 3, "min": 0, "max": 3}, {"name": "filler_weight_coins", "display_name": "Filler Weight: Coins", "description": "Weight for Coins in the filler pool. Set to 0 to disable this filler.\nPlease note that if you turn off all traps below, this filler item will be chosen to fill all remaining spots regardless of chosen weight.", "randomizable": true, "visibility": 15, "type": "Range", "default": 80, "min": 0, "max": 100}, {"name": "trap_weight_tired_goose", "display_name": "Trap Weight: Tired Goose", "description": "Weight for Tired Goose trap in the filler pool. Set to 0 to disable this trap.", "randomizable": true, "visibility": 15, "type": "Range", "default": 5, "min": 0, "max": 100}, {"name": "trap_weight_confused_feet", "display_name": "Trap Weight: Confused Feet", "description": "Weight for Confused Feet trap in the filler pool. Set to 0 to disable this trap.", "randomizable": true, "visibility": 15, "type": "Range", "default": 5, "min": 0, "max": 100}, {"name": "trap_weight_butterbeak", "display_name": "Trap Weight: Butterbeak", "description": "Weight for Butterbeak trap in the filler pool. Set to 0 to disable this trap.", "randomizable": true, "visibility": 15, "type": "Range", "default": 5, "min": 0, "max": 100}, {"name": "trap_weight_suspicious_goose", "display_name": "Trap Weight: Suspicious Goose", "description": "Weight for Suspicious Goose trap in the filler pool. Set to 0 to disable this trap.", "randomizable": true, "visibility": 15, "type": "Range", "default": 5, "min": 0, "max": 100}, {"name": "death_link", "display_name": "Death Link", "description": "When you get caught/shooed, everyone dies. When someone else dies, you drop whatever you're holding and get teleported to the hub.", "randomizable": true, "visibility": 15, "type": "Toggle", "default": false}], "collapsed": false}, {"name": "Item & Location Options", "options": [{"name": "local_items", "display_name": "Local Items", "description": "Forces these items to be in their native world.", "randomizable": false, "visibility": 15, "type": "OptionSet", "default": [], "options": ["Garden Access", "High Street Access", "Back Gardens Access", "Pub Access", "Model Village Access", "Progressive Area", "Groundskeeper's Soul", "Boy's Soul", "TV Shop Owner's Soul", "Market Lady's Soul", "Tidy Neighbour's Soul", "Messy Neighbour's Soul", "Burly Man's Soul", "Old Man's Soul", "Pub Lady's Soul", "Fancy Ladies' Souls", "Cook's Soul", "Carrots", "Tomatoes", "Pumpkins", "Topsoil Bags", "Quoits (Green)", "Plates", "Oranges", "Leeks", "Cucumbers", "Quoits (Red)", "Umbrellas", "Tinned Food", "Socks", "Pint Bottles", "Knives", "Gumboots", "Forks", "Apple Cores", "Apples", "Sandwich", "Ribbons", "Walkie Talkies", "Boots", "Miniature People", "Miniature Benches", "Weed Tools", "Radio", "Cabbages", "Trowel", "Tulip", "Jam", "Picnic Mug", "Thermos", "Sun Hat", "Drink Can", "Tennis Ball", "Rake", "Picnic Basket", "Esky", "Shovel", "Watering Can", "Mallet", "Wooden Crate", "Horn-Rimmed Glasses", "Red Glasses", "Sunglasses", "Loo Paper", 