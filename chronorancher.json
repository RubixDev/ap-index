{"name": "chronorancher", "game": "The Chrono-Rancher", "version": "1.1.0", "hidden": false, "groups": [{"name": "Game Options", "options": [{"name": "progression_balancing", "display_name": "Progression Balancing", "description": "A system that can move progression earlier, to try and prevent the player from getting stuck and bored early.\n\nA lower setting means more getting stuck. A higher setting means less getting stuck.", "randomizable": true, "visibility": 15, "type": "NamedRange", "default": 50, "min": 0, "max": 99, "presets": {"disabled": 0, "normal": 50, "extreme": 99}}, {"name": "accessibility", "display_name": "Accessibility", "description": "Set rules for reachability of your items/locations.\n\n**Full:** ensure everything can be reached and acquired.\n\n**Minimal:** ensure what is needed to reach your goal can be acquired.", "randomizable": true, "visibility": 15, "type": "Choice", "default": 0, "choices": [{"name": "full", "display_name": "Full", "value": 0}, {"name": "minimal", "display_name": "Minimal", "value": 2}]}, {"name": "victory_condition", "display_name": "Victory Condition", "description": "What the Victory Condition should be.\n**Percent of Levels** requires the player to beat a certain percent of all levels (determined in goal_level_percent option)\n**Key Levels** requires the player to beat certain key levels (which levels and how many are set in key_levels_to_beat and num_key_levels)", "randomizable": true, "visibility": 15, "type": "Choice", "default": 0, "choices": [{"name": "percent_of_levels", "display_name": "Percent Of Levels", "value": 0}, {"name": "key_levels", "display_name": "Key Levels", "value": 1}]}, {"name": "goal_level_percent", "display_name": "Goal Level Percent", "description": "If **Percent of Levels** goal is set, what percent of levels need to be beaten to win? (Rounds up)", "randomizable": true, "visibility": 15, "type": "NamedRange", "default": "half", "min": 1, "max": 100, "presets": {"half": 50, "all": 100}}, {"